# ================================================================
# FIFA Content Creator — Environment Variables
# Copy to .env and fill in your keys
# ================================================================

# ---- REQUIRED: Claude API (script writing brain) ----
# Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-8

# ---- REQUIRED: YouTube API (video upload) ----
# How to get:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project → Enable "YouTube Data API v3"
#   3. APIs & Services → Credentials → Create OAuth 2.0 Client ID (Desktop app)
#   4. Download the JSON, copy client_id and client_secret below
# Then run: node setup.js  (one-time auth flow)
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_client_secret
YOUTUBE_PRIVACY=public

# ---- RECOMMENDED: Stock media (royalty-free images/video) ----
# Pexels free API: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay free API: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ---- OPTIONAL: AI image generation (fallback when stock fails) ----
# Stability AI: https://platform.stability.ai/
STABILITY_API_KEY=

# ---- OPTIONAL: News API (80,000+ sources, 100 req/day free) ----
# https://newsapi.org/register
NEWS_API_KEY=

# ---- OPTIONAL: Text-to-speech (adds AI voice narration to videos) ----
# ElevenLabs (best quality): https://elevenlabs.io/
ELEVENLABS_API_KEY=

# OpenAI TTS (alternative): https://platform.openai.com/
OPENAI_API_KEY=

# ---- Scheduler ----
# Cron syntax. Default: daily at noon UTC
SCHEDULE_CRON=0 12 * * *

# ---- Video settings ----
# "auto" = Claude picks the best format per story
# "short" = always produce YouTube Shorts (<60s vertical)
# "long"  = always produce long-form (7-10min horizontal)
VIDEO_FORMAT=auto
